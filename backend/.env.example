# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to sqlite:///./wifisense.db
DATABASE_URL=sqlite:///./wifisense.db

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 to populate the database with demo organizations, users and devices.
# Demo accounts use publicly documented passwords - never enable outside local development.
SEED_DEMO_DATA=0

# Maximum profile photo size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880
