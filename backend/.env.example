# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to sqlite:///./wifisense.db
DATABASE_URL=sqlite:///./wifisense.db

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 to populate the database with demo organizations, users and devices.
# Demo accounts use publicly documented passwords - never enable outside local development.
SEED_DEMO_DATA=0

# First system administrator. Created on startup only while no administrator exists;
# unset both after the account is created and change the password on first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Maximum profile photo size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# -----------------------------------------------------------------------------
# Family Care Plan Subscriptions (SANDBOX Provider)
# -----------------------------------------------------------------------------
# Payment provider mode: currently only 'sandbox' is implemented.
PAYMENTS_MODE=sandbox

# Secret key used to sign and verify payment webhook signatures.
# In development, auto-generates per process if omitted. Required in production.
PAYMENT_WEBHOOK_SECRET=

# Sandbox simulator gating: gates POST /payments/checkout,
# POST /payments/sandbox/checkout/{id}/complete, and POST /payments/sandbox/simulate.
# Defaults to true outside production (development/testing).
# Defaults to false (off) in production. When disabled, these simulation endpoints return 404.
# Webhook signature verification (POST /payments/webhooks/sandbox) is not affected.
# To explicitly opt-in and enable simulation in production, uncomment the line below:
# PAYMENTS_SANDBOX_SIMULATOR_ENABLED=1


# Razorpay (optional). PAYMENTS_MODE=sandbox (default) or razorpay. These are SECRETS: set them in your host's dashboard, never commit values.
# PAYMENTS_MODE=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_ALLOW_LIVE=0
